# -- Eco-Router Configuration --------------------------------------------------
# Copy this file to .env and adjust values.
# NEVER commit .env to version control.

# -- Authentication ------------------------------------------------------------
# Secret key used for signing JWT tokens. 
# Generate a strong random string in production (e.g., `openssl rand -hex 32`)
AUTH_SECRET=

# -- Application ---------------------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# -- Carbon Provider -----------------------------------------------------------
# Options: mock | electricity_maps | carbon_aware_sdk
# "mock" works without any API key - safe for demos.
CARBON_PROVIDER=mock

# Seconds before a carbon reading is considered stale
CARBON_CACHE_TTL=300

# Seconds between background carbon data refreshes
CARBON_UPDATE_INTERVAL=60

# -- Database ------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./eco_router.db

# -- Request Settings ----------------------------------------------------------
REQUEST_TIMEOUT=10
MAX_REQUEST_BODY_SIZE=10485760

# -- Health Checks -------------------------------------------------------------
HEALTH_CHECK_INTERVAL=30

# -- Carbon Savings Methodology ------------------------------------------------
# Estimated energy consumed per proxied request (kWh).
# This is a configurable assumption - label all savings as ESTIMATED.
ENERGY_PER_REQUEST_KWH=0.0001

# -- Mock Carbon Values (gCO2e/kWh) -------------------------------------------
# Change these to simulate different routing scenarios.
# Scenario A: EU is greenest (default)
MOCK_CARBON_US_EAST_1=340.0
MOCK_CARBON_EU_NORTH_1=70.0
MOCK_CARBON_AP_SOUTH_1=180.0

# -- Optional: Electricity Maps API --------------------------------------------
# SERVICE:       Electricity Maps
# KEY NAME:      ELECTRICITY_MAPS_API_KEY
# WHERE:         https://api.electricitymap.org (free tier available)
# REQUIRED:      No - only needed when CARBON_PROVIDER=electricity_maps
# HOW USED:      Passed as "auth-token" header to Electricity Maps REST API v3
ELECTRICITY_MAPS_API_KEY=

# -- Optional: Green Software Foundation Carbon Aware SDK ----------------------
# SERVICE:       GSF Carbon Aware SDK
# KEY NAME:      CARBON_AWARE_SDK_URL
# WHERE:         Self-host from https://github.com/Green-Software-Foundation/carbon-aware-sdk
# REQUIRED:      No - only needed when CARBON_PROVIDER=carbon_aware_sdk
# HOW USED:      Base URL for SDK REST API endpoint
CARBON_AWARE_SDK_URL=

# -- Optional: Eco Intelligence (AI-powered insights) --------------------------
# SERVICE:       Google Gemini
# KEY NAME:      GEMINI_API_KEY
# WHERE:         https://aistudio.google.com/app/apikey
# REQUIRED:      No - application runs in AI DEMO MODE without this key.
# HOW USED:      Server-side only via google-genai SDK.
#                NEVER exposed to frontend JavaScript.
#                NEVER committed to version control.
#
# Without this key:  Eco Intelligence runs in AI DEMO MODE
#                    (deterministic template-based explanations - fully functional)
# With this key:     Eco Intelligence runs in AI ANALYSIS MODE
#                    (Gemini-powered natural language explanations)
GEMINI_API_KEY=

# Gemini model to use. Default: gemini-2.0-flash (fast, low cost)
# Other options: gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.0-flash


# ----------------------------------------------------------------------------
# PHASE B-I: UPCOMING INTEGRATIONS
# ----------------------------------------------------------------------------

# -- Phase C: Carbon Forecasting -----------------------------------------------
FORECAST_ENABLED=true
FORECAST_WINDOW_HOURS=6
FORECAST_HORIZON_STEPS=6

# -- Phase D: RAG Knowledge System --------------------------------------------
RAG_ENABLED=true

# -- Phase E: PostgreSQL (Production) -----------------------------------------
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eco_router

# -- Phase F: Prometheus -------------------------------------------------------
PROMETHEUS_ENABLED=true

# -- Phase H: AWS --------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# -- Phase I: Kubernetes -------------------------------------------------------
KUBERNETES_MODE=false

# -- Phase J: Voice AI --------------------------------------------------------
VOICE_ENABLED=true