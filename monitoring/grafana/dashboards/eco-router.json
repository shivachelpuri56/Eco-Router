{
  "title": "ECO-ROUTER — CARBON AWARE INFRASTRUCTURE",
  "description": "Real-time carbon-aware routing telemetry. ESTIMATED POTENTIAL SAVINGS are calculated from simulated data and are not verified real-world emission reductions.",
  "uid": "eco-router-v1",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "tags": ["eco-router", "carbon", "infrastructure", "sustainability"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests Routed",
      "description": "Total number of requests forwarded by the carbon-aware proxy.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(eco_router_requests_total)",
          "legendFormat": "Requests"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Carbon-Aware Decisions",
      "description": "Total routing decisions made by the deterministic engine.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(eco_router_routing_decisions_total)",
          "legendFormat": "Decisions"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#1B4332", "value": null }] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ESTIMATED Potential Savings",
      "description": "ESTIMATED POTENTIAL — calculated from simulated data. Not verified real-world emission reductions.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "eco_router_carbon_savings_gco2e_total",
          "legendFormat": "gCO₂e (estimated)"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 6, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Application Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "eco_router_uptime_seconds",
          "legendFormat": "Uptime"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Current Carbon Intensity — US East (gCO₂e/kWh)",
      "description": "Grid carbon intensity for simulated US East region. MOCK DATA.",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "eco_router_carbon_intensity_gauge{region=\"us-east-1\"}",
          "legendFormat": "US East"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizWidth": 75, "minVizHeight": 75 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 600, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 150 }, { "color": "red", "value": 300 }] } } }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Current Carbon Intensity — EU North (gCO₂e/kWh)",
      "description": "Grid carbon intensity for simulated EU North region (Stockholm). MOCK DATA.",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "eco_router_carbon_intensity_gauge{region=\"eu-north-1\"}",
          "legendFormat": "EU North"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 600, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 150 }, { "color": "red", "value": 300 }] } } }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Current Carbon Intensity — AP South (gCO₂e/kWh)",
      "description": "Grid carbon intensity for simulated Asia Pacific region (Mumbai). MOCK DATA.",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "eco_router_carbon_intensity_gauge{region=\"ap-south-1\"}",
          "legendFormat": "AP South"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 600, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 150 }, { "color": "red", "value": 300 }] } } }
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Region Health Status",
      "description": "1 = available, 0.5 = degraded, 0 = unavailable",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "eco_router_region_health_gauge",
          "legendFormat": "{{region}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Carbon Intensity Over Time — All Regions",
      "description": "Historical carbon intensity per region (MOCK DATA — simulated grid values).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "eco_router_carbon_intensity_gauge",
          "legendFormat": "{{region}}"
        }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Routing Distribution by Region",
      "description": "Share of carbon-aware routing decisions by selected region.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (region) (eco_router_routing_decisions_total)",
          "legendFormat": "{{region}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request Latency (p95) by Region",
      "description": "95th percentile request latency in seconds, per region.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le, region) (rate(eco_router_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{region}}"
        }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "AI Eco Intelligence Requests",
      "description": "Total requests to the AI orchestrator by intent and mode.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 18 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (intent) (eco_router_ai_requests_total)",
          "legendFormat": "{{intent}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    }
  ]
}
